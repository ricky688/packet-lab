#!/usr/bin/env python3
"""Open the bundled Packet Lab recipient picker for local files."""
from pathlib import Path
import subprocess
import sys
import time

from gi.repository import Gio, GLib


def main():
    files = [str(Path(name).absolute()) for name in sys.argv[1:]]
    if not files or any(not Path(name).is_file() for name in files):
        raise ValueError("Select one or more local files; folders are not supported.")
    launcher = Path(__file__).resolve().with_name("packet-lab")
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    app = "io.github.ricky688.PacketLab"
    path = "/io/github/ricky688/PacketLab/Share"
    process = subprocess.Popen(
        [str(launcher)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )
    deadline = time.monotonic() + 10
    while True:
        try:
            bus.call_sync(app, path, "org.gtk.Actions", "Describe",
                          GLib.Variant("(s)", ("send-files",)), None,
                          Gio.DBusCallFlags.NO_AUTO_START, 500, None)
            break
        except GLib.Error:
            if process.poll() not in (None, 0) or time.monotonic() >= deadline:
                raise RuntimeError("Packet Lab could not start or export its send-files action.")
            time.sleep(0.1)
    bus.call_sync(app, path, "org.gtk.Actions", "Activate",
                  GLib.Variant("(sava{sv})", (
                      "send-files", [GLib.Variant("as", files)], {},
                  )), None, Gio.DBusCallFlags.NO_AUTO_START, 3000, None)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, GLib.Error) as error:
        print(f"Packet Lab: {error}", file=sys.stderr)
        sys.exit(1)
